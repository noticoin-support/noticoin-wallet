# Generate a random 32-byte token; put the SAME value in map/.env.
NOTICOIN_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
NOTICOIN_WALLET_USER=noticoin-map
NOTICOIN_WALLET_PASSWORD=REPLACE_WITH_RANDOM_RPC_PASSWORD
NOTICOIN_WALLET_URL=http://127.0.0.1:19083
NOTICOIN_DAEMON_URL=http://127.0.0.1:19081
NOTICOIN_NETWORK=mainnet
NOTICOIN_BRIDGE_PORT=8788
NOTICOIN_MAP_URL=http://127.0.0.1:5173
# New pin invoices use a separate wallet and a different token (same value in map/.env).
NOTICOIN_FUND_BRIDGE_TOKEN=
NOTICOIN_FUND_WALLET_URL=http://127.0.0.1:19084
NOTICOIN_FUND_WALLET_USER=noticoin-fund
NOTICOIN_FUND_WALLET_PASSWORD=
NOTICOIN_FUND_ADDRESS=
# Absolute path to site/dist/fund-report.json. Optional descriptions use a JSON object keyed by outgoing txid.
NOTICOIN_FUND_REPORT_FILE=
NOTICOIN_FUND_PURPOSES_FILE=
# Only for an isolated development chain. Leave off for real payments.
NOTICOIN_ALLOW_ISOLATED_DEV=0
